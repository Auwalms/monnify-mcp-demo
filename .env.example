PORT=3000
MONNIFY_API_KEY=your_sandbox_api_key
MONNIFY_SECRET_KEY=your_sandbox_secret_key
MONNIFY_CONTRACT_CODE=your_sandbox_contract_code
MONNIFY_BASE_URL=https://sandbox.monnify.com

# Optional: fill in to demo subaccount fee-splitting on checkout/reserved-account
# funding. Leave blank to skip fee-splitting entirely.
MONNIFY_SUBACCOUNT_CODE=
MONNIFY_SUBACCOUNT_SPLIT_PERCENTAGE=10

# Where Monnify redirects the browser after a checkout link payment completes.
CHECKOUT_REDIRECT_URL=http://localhost:3000
ADMIN_PASSWORD=
